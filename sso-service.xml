<service>
    <id>sysnormal-sso-service</id>
    <name>Sysnormal SSO Service</name>
    <description>Aplicação Java SYSNORMAL-SSO-SERVICE rodando como serviço</description>
    <executable>java</executable>
    <arguments>-jar D:\PROJECTS\INFORMATIC\SYSNORMAL\security\auth\sso\sso-service\target\sso-service-0.0.1-SNAPSHOT.jar --spring.profiles.active=prod</arguments>
    <logpath>D:\PROJECTS\INFORMATIC\SYSNORMAL\security\auth\sso\sso-service\logs</logpath>

    <log mode="roll"/>

    <!-- Reinício automático quando o java sai com erro; a última ação se repete. Zera a contagem após 1 hora no ar. -->
    <onfailure action="restart" delay="10 sec"/>
    <onfailure action="restart" delay="30 sec"/>
    <onfailure action="restart" delay="60 sec"/>
    <resetfailure>1 hour</resetfailure>
</service>
